{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ulisse-config.schema.json",
  "title": "UlisseConfig",
  "type": "object",
  "required": [
    "projectName",
    "localUrl",
    "language",
    "framework",
    "database",
    "stackProfile",
    "skipDeployment",
    "buildAgent",
    "qaAgent",
    "architectureAgent",
    "browserAgent",
    "maxBudget"
  ],
  "additionalProperties": true,
  "not": {
    "anyOf": [
      { "required": ["targetUrl"] },
      { "required": ["targetName"] },
      { "required": ["cloudProvider"] }
    ]
  },
  "properties": {
    "projectName": { "type": "string", "minLength": 1 },
    "localUrl": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 1 },
    "framework": { "type": "string", "minLength": 1 },
    "database": { "type": "string", "minLength": 1 },
    "stackProfile": { "type": "string", "minLength": 1 },
    "authMode": { "type": "string" },
    "skipDeployment": { "type": "boolean" },
    "buildAgent": { "type": "string", "enum": ["codex", "claude"] },
    "buildModel": { "type": "string", "minLength": 1 },
    "buildRole": { "type": "string" },
    "qaAgent": { "type": "string", "enum": ["codex", "claude"] },
    "qaModel": { "type": "string", "minLength": 1 },
    "qaReasoningEffort": { "type": "string", "enum": ["minimal", "low", "medium", "high"] },
    "qaRole": { "type": "string" },
    "architectureAgent": { "type": "string", "enum": ["codex", "claude"] },
    "architectureModel": { "type": "string", "minLength": 1 },
    "architectureReasoningEffort": { "type": "string", "enum": ["minimal", "low", "medium", "high"] },
    "codexModel": { "type": "string", "minLength": 1 },
    "claudeModel": { "type": "string", "minLength": 1 },
    "reasoningEffort": { "type": "string", "enum": ["minimal", "low", "medium", "high"] },
    "browserAgent": { "type": "string" },
    "maxBudget": { "type": "number" }
  }
}
