{
  "name": "shepherd-acceptance-playground",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3055",
    "build": "next build",
    "start": "next start -p 3055",
    "test": "vitest run",
    "test:browser": "env -u FORCE_COLOR -u NO_COLOR playwright test",
    "test:all": "npm run test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vitest": "4.0.15"
  },
  "overrides": {
    "postcss": "8.5.15"
  }
}
